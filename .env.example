# =============================================================================
# Kiduka Labs — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND — API Server
# -----------------------------------------------------------------------------

# Environment: "development" | "production"
ENVIRONMENT=development

# Public URL of the frontend — used to build links in emails (password reset, notifications)
# Development: http://localhost:3000
# Production:  https://kiduka-labs.co.ke
FRONTEND_URL=http://localhost:3000

# Server binding
API_HOST=0.0.0.0
API_PORT=8000

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# BACKEND — Security (REQUIRED)
# -----------------------------------------------------------------------------

# Secret key for server-side session middleware (SessionMiddleware).
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Secret key used to sign JWT access tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# -----------------------------------------------------------------------------
# BACKEND — Database (REQUIRED)
# -----------------------------------------------------------------------------

# Full async-compatible PostgreSQL connection string.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://agri_user:agri_password@localhost:5432/agricultural_api

# Credentials used by docker-compose to initialise the Postgres container.
# Must match the values embedded in DATABASE_URL above.
POSTGRES_DB=agricultural_api
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=agri_password


# -----------------------------------------------------------------------------
# BACKEND — Google Earth Engine (REQUIRED for predictions)
# -----------------------------------------------------------------------------

# GCP project ID that has Earth Engine API enabled.
GEE_PROJECT_ID=your-gcp-project-id

# Absolute or repo-relative path to your GCP service account JSON key file.
# The file must NOT be committed to version control.
GOOGLE_APPLICATION_CREDENTIALS=api/credentials/your-service-account-key.json


# -----------------------------------------------------------------------------
# BACKEND — OpenAI (REQUIRED for AI recommendations)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-...your-openai-api-key...


# -----------------------------------------------------------------------------
# BACKEND — Pinecone (REQUIRED for chatbot RAG)
# -----------------------------------------------------------------------------

PINECONE_API_KEY=pcsk_...your-pinecone-api-key...


# -----------------------------------------------------------------------------
# BACKEND — WOFOST / PCSE yield model (optional)
# -----------------------------------------------------------------------------

# Directory for caching WOFOST simulation outputs.
# Defaults to /tmp/kiduka_wofost_cache if not set.
KIDUKA_WOFOST_CACHE_DIR=/tmp/kiduka_wofost_cache

# Path to PCSE home directory (weather data cache etc.).
# Defaults to $KIDUKA_WOFOST_CACHE_DIR/pcse_home if not set.
KIDUKA_PCSE_HOME=/tmp/kiduka_wofost_cache/pcse_home

# Path to R library directory used by the RQUEFTS yield model.
# Only needed if the RQUEFTS solver is enabled.
# RQUEFTS_R_LIBS_PATH=/usr/local/lib/R/library


# -----------------------------------------------------------------------------
# BACKEND — Default admin account (created on first startup)
# -----------------------------------------------------------------------------

RECOVERY_ADMIN_EMAIL=admin@example.com
RECOVERY_ADMIN_USERNAME=admin
RECOVERY_ADMIN_PASSWORD=change-me-strong-password


# -----------------------------------------------------------------------------
# BACKEND — Resend (email notifications to farmers)
# -----------------------------------------------------------------------------

# API key from resend.com → API Keys (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# Sender address — must be an address at your verified Resend domain
MAIL_FROM=noreply@kiduka-labs.co.ke

# Display name shown in the recipient's inbox
MAIL_FROM_NAME=Kiduka Platform


# -----------------------------------------------------------------------------
# BACKEND — pgAdmin (docker-compose only, optional)
# -----------------------------------------------------------------------------

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me


# -----------------------------------------------------------------------------
# FRONTEND — Next.js / NextAuth
# -----------------------------------------------------------------------------

# The public URL of your Next.js app. Used by NextAuth for callbacks.
# In development: http://localhost:3000
# In production:  https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign NextAuth session tokens and CSRF tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32


# -----------------------------------------------------------------------------
# FRONTEND — Google OAuth (optional — only if Google sign-in is enabled)
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret


# -----------------------------------------------------------------------------
# FRONTEND — API URLs
# -----------------------------------------------------------------------------

# URL used by the browser to reach the backend (public-facing).
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL used by the Next.js server to reach the backend (internal / Docker network).
# In docker-compose this is the service name, e.g. http://api:8000
API_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# TESTS
# -----------------------------------------------------------------------------

# Base URL for integration tests that hit the live API.
# Defaults to http://localhost:8000 if not set.
# KIDUKA_API_URL=http://localhost:8000

# Credentials used by integration tests to authenticate against the API.
# Defaults to RECOVERY_ADMIN_USERNAME / RECOVERY_ADMIN_PASSWORD if not set.
# KIDUKA_TEST_USERNAME=test-user-or-email
# KIDUKA_TEST_PASSWORD=test-password
